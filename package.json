		"check": "npm run lint && npm run build"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"esbuild": "0.28.1",
		"eslint": "10.5.0",
		"obsidian": "1.13.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.61.0"
	}
}
