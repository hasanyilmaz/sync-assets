{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"lib": [
			"DOM",
			"ES2022"
		],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2018",
		"useDefineForClassFields": true
	},
	"include": [
		"main.ts",
		"src/**/*.ts",
		"tests/**/*.ts"
	]
}
